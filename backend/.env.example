# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/urbain_sustainability
DATABASE_TEST_URL=postgresql://username:password@localhost:5432/urbain_sustainability_test

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@urbain-sustainability.com
EMAIL_FROM_NAME=Urbain Sustainability System

# AI Model Configuration
AI_MODEL_PATH=./models/urban_classifier.pkl
AI_CONFIDENCE_THRESHOLD=0.7

# Application Configuration
APP_NAME=Urbain Sustainability System
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Monitoring
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090
